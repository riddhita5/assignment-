import 'dart:io';
import 'package:firebase_storage/firebase_storage.dart';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

class GalleryScreen extends StatefulWidget {
  const GalleryScreen({super.key});

  @override
  State<GalleryScreen> createState() => _GalleryScreenState();
}

class _GalleryScreenState extends State<GalleryScreen> {
  final List<File> _selectedImages = [];
  final List<String> _uploadedUrls = [];
  bool _isUploading = false;
  final ImagePicker _picker = ImagePicker();

  // ઈમેજ સિલેક્ટ કરવાનું ફંક્શન (મહત્તમ 3)
  Future<void> _pickImages() async {
    if (_selectedImages.length >= 3) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('તમે વધુમાં વધુ 3 ઈમેજ પસંદ કરી શકો છો.')),
      );
      return;
    }

    final List<XFile> pickedFiles = await _picker.pickMultiImage(
      imageQuality: 50,
    );

    setState(() {
      if (pickedFiles.isNotEmpty) {
        // જો 3 થી વધારે સિલેક્ટ કરી હોય તો ફક્ત પહેલી 3 લેવી અથવા બાકી રહેલી જગ્યા મુજબ લેવી
        int remainingSpace = 3 - _selectedImages.length;
        for (var i = 0; i < pickedFiles.length && i < remainingSpace; i++) {
          _selectedImages.add(File(pickedFiles[i].path));
        }
      }
    });
  }

  // બધી પસંદ કરેલી ઈમેજ અપલોડ કરવાનું ફંક્શન
  Future<void> _uploadImages() async {
    if (_selectedImages.isEmpty) return;

    setState(() {
      _isUploading = true;
      _uploadedUrls.clear();
    });

    try {
      for (File image in _selectedImages) {
        String fileName = 'gallery_${DateTime.now().millisecondsSinceEpoch}_${_selectedImages.indexOf(image)}.jpg';
        Reference ref = FirebaseStorage.instance.ref().child('gallery').child(fileName);
        
        UploadTask uploadTask = ref.putFile(image);
        TaskSnapshot snapshot = await uploadTask;
        String url = await snapshot.ref.getDownloadURL();
        
        setState(() {
          _uploadedUrls.add(url);
        });
      }
      
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('બધી ઈમેજ સફળતાપૂર્વક અપલોડ થઈ ગઈ છે!')),
      );
    } catch (e) {
      print('Upload error: $e');
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('ભૂલ આવી: $e')),
      );
    } finally {
      setState(() {
        _isUploading = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Gallery Upload (Task 2)'),
        backgroundColor: Colors.purple,
        foregroundColor: Colors.white,
      ),
      body: Column(
        children: [
          const SizedBox(height: 20),
          // પસંદ કરેલી ઈમેજનું પ્રિવ્યુ
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: _selectedImages.map((file) {
              return Padding(
                padding: const EdgeInsets.all(8.0),
                child: Stack(
                  children: [
                    Image.file(file, width: 80, height: 80, fit: BoxFit.cover),
                    Positioned(
                      right: 0,
                      top: 0,
                      child: GestureDetector(
                        onTap: () => setState(() => _selectedImages.remove(file)),
                        child: const Icon(Icons.cancel, color: Colors.red),
                      ),
                    ),
                  ],
                ),
              );
            }).toList(),
          ),
          
          if (_selectedImages.length < 3)
            ElevatedButton.icon(
              onPressed: _pickImages,
              icon: const Icon(Icons.photo_library),
              label: const Text('પસંદ કરો (મહત્તમ 3)'),
            ),
            
          const SizedBox(height: 10),
          
          if (_selectedImages.isNotEmpty)
            ElevatedButton(
              onPressed: _isUploading ? null : _uploadImages,
              style: ElevatedButton.styleFrom(backgroundColor: Colors.purple, foregroundColor: Colors.white),
              child: _isUploading 
                ? const SizedBox(width: 20, height: 20, child: CircularProgressIndicator(color: Colors.white, strokeWidth: 2))
                : const Text('બધી ઈમેજ અપલોડ કરો'),
            ),
            
          const Divider(height: 40),
          const Text('Uploaded URLs:', style: TextStyle(fontWeight: FontWeight.bold)),
          
          // અપલોડ થયેલ URLs નું લિસ્ટ
          Expanded(
            child: ListView.builder(
              itemCount: _uploadedUrls.length,
              itemBuilder: (context, index) {
                return ListTile(
                  leading: const Icon(Icons.link, color: Colors.blue),
                  title: Text(_uploadedUrls[index], style: const TextStyle(fontSize: 12)),
                  trailing: IconButton(
                    icon: const Icon(Icons.copy),
                    onPressed: () {
                      // અહીં તમે ક્લિપબોર્ડ પર કોપી કરવાનું લોજિક ઉમેરી શકો
                    },
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}
