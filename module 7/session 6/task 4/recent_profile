import 'package:firebase_storage/firebase_storage.dart';
import 'package:flutter/material.dart';

class RecentProfileScreen extends StatefulWidget {
  const RecentProfileScreen({super.key});

  @override
  State<RecentProfileScreen> createState() => _RecentProfileScreenState();
}

class _RecentProfileScreenState extends State<RecentProfileScreen> {
  String? _imageUrl;
  bool _isLoading = true;
  String? _errorMessage;

  @override
  void initState() {
    super.initState();
    _fetchMostRecentImage();
  }

  // Firebase Storage માંથી સૌથી લેટેસ્ટ ઈમેજ મેળવવાનું ફંક્શન
  Future<void> _fetchMostRecentImage() async {
    try {
      setState(() {
        _isLoading = true;
        _errorMessage = null;
      });

      final storageRef = FirebaseStorage.instance.ref().child('profile_pics');
      
      // બધી ફાઈલોનું લિસ્ટ મેળવવું
      final ListResult result = await storageRef.listAll();

      if (result.items.isEmpty) {
        setState(() {
          _isLoading = false;
          _errorMessage = "કોઈ પ્રોફાઈલ પિક્ચર મળ્યું નથી.";
        });
        return;
      }

      // Metadata મેળવીને સમય મુજબ સૌથી લેટેસ્ટ ફાઈલ શોધવી
      FullMetadata? latestMetadata;
      Reference? latestRef;

      for (var ref in result.items) {
        final metadata = await ref.getMetadata();
        if (latestMetadata == null || 
            (metadata.timeCreated != null && metadata.timeCreated!.isAfter(latestMetadata.timeCreated!))) {
          latestMetadata = metadata;
          latestRef = ref;
        }
      }

      if (latestRef != null) {
        final url = await latestRef.getDownloadURL();
        setState(() {
          _imageUrl = url;
          _isLoading = false;
        });
      } else {
        setState(() {
          _isLoading = false;
          _errorMessage = "ઈમેજ લોડ કરી શકાઈ નથી.";
        });
      }

    } catch (e) {
      print("Error: $e");
      setState(() {
        _isLoading = false;
        _errorMessage = "Error: $e";
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Recent Profile (Task 4)'),
        backgroundColor: Colors.indigo,
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Text(
              'સૌથી છેલ્લે અપલોડ કરેલ પ્રોફાઈલ:',
              style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 20),
            
            // CircleAvatar માં ઈમેજ ડિસ્પ્લે
            _isLoading
                ? const CircularProgressIndicator()
                : CircleAvatar(
                    radius: 80,
                    backgroundColor: Colors.grey[200],
                    backgroundImage: _imageUrl != null ? NetworkImage(_imageUrl!) : null,
                    child: _imageUrl == null
                        ? const Icon(Icons.person, size: 80, color: Colors.grey)
                        : null,
                  ),
            
            const SizedBox(height: 20),
            
            if (_errorMessage != null)
              Text(_errorMessage!, style: const TextStyle(color: Colors.red)),
            
            const SizedBox(height: 30),
            
            ElevatedButton.icon(
              onPressed: _fetchMostRecentImage,
              icon: const Icon(Icons.refresh),
              label: const Text('Refresh / Fetch Latest'),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.indigo,
                foregroundColor: Colors.white,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
