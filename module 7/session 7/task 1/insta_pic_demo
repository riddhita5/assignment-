import 'dart:io';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

class InstaPicDemo extends StatefulWidget {
  const InstaPicDemo({super.key});

  @override
  State<InstaPicDemo> createState() => _InstaPicDemoState();
}

class _InstaPicDemoState extends State<InstaPicDemo> {
  File? _image;
  final ImagePicker _picker = ImagePicker();

  // ગેલેરીમાંથી ફોટો પસંદ કરવાનું ફંક્શન
  Future<void> _pickImage() async {
    final XFile? pickedFile = await _picker.pickImage(source: ImageSource.gallery);

    if (pickedFile != null) {
      setState(() {
        _image = File(pickedFile.path);
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('InstaPicDemo (Task 1)'),
        backgroundColor: Colors.blueAccent,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // પસંદ કરેલ ફોટો બતાવવો
            Container(
              width: 300,
              height: 300,
              decoration: BoxDecoration(
                color: Colors.grey[200],
                border: Border.all(color: Colors.blueAccent),
              ),
              child: _image != null
                  ? Image.file(_image!, fit: BoxFit.cover)
                  : const Icon(Icons.image, size: 100, color: Colors.grey),
            ),
            const SizedBox(height: 20),
            ElevatedButton.icon(
              onPressed: _pickImage,
              icon: const Icon(Icons.photo_library),
              label: const Text('Pick Photo from Gallery'),
            ),
          ],
        ),
      ),
    );
  }
}
