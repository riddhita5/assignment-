import 'dart:io';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

class SelfieDemo extends StatefulWidget {
  const SelfieDemo({super.key});

  @override
  State<SelfieDemo> createState() => _SelfieDemoState();
}

class _SelfieDemoState extends State<SelfieDemo> {
  File? _image;
  final ImagePicker _picker = ImagePicker();

  // કેમેરાનો ઉપયોગ કરીને સેલ્ફી લેવાનું ફંક્શન
  Future<void> _takeSelfie() async {
    final XFile? pickedFile = await _picker.pickImage(
      source: ImageSource.camera,
      preferredCameraDevice: CameraDevice.front, // ફ્રન્ટ કેમેરા ઓપન કરવા માટે
    );

    if (pickedFile != null) {
      setState(() {
        _image = File(pickedFile.path);
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Take Selfie (Task 2)'),
        backgroundColor: Colors.teal,
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // Circular Avatar Preview
            CircleAvatar(
              radius: 100,
              backgroundColor: Colors.grey[300],
              backgroundImage: _image != null ? FileImage(_image!) : null,
              child: _image == null
                  ? const Icon(Icons.camera_alt, size: 80, color: Colors.white)
                  : null,
            ),
            const SizedBox(height: 40),
            
            ElevatedButton.icon(
              onPressed: _takeSelfie,
              icon: const Icon(Icons.face),
              label: const Text('Take Selfie'),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.teal,
                foregroundColor: Colors.white,
                padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
